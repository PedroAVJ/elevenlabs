require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_USE_RN_DEP'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['EXPO_USE_PRECOMPILED_MODULES'] = '0' if podfile_properties['EXPO_USE_PRECOMPILED_MODULES'] == 'false'
ENV['EXPO_USE_PRECOMPILED_MODULES'] ||= '1'

platform :ios, podfile_properties['ios.deploymentTarget'] || '17.0'
prepare_react_native_project!

target 'ElevenLabs' do
  use_expo_modules!

  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  target 'ElevenLabsTests' do
    # The host app already links the Expo/React Native runtime. Tests only need
    # its generated module search paths for `@testable import ElevenLabs`.
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
  end
end

post_integrate do |_installer|
  # A hosted unit-test bundle imports the app's compiled module, so it needs
  # CocoaPods' module search paths but must not link Expo's static runtime a
  # second time. Expo autolinking otherwise injects its provider and linker
  # flags into the test bundle, which aborts before XCTest can start.
  project = Xcodeproj::Project.open(File.join(__dir__, 'ElevenLabs.xcodeproj'))
  test_target = project.targets.find { |target| target.name == 'ElevenLabsTests' }

  if test_target
    test_target.source_build_phase.files.each do |build_file|
      path = build_file.file_ref&.path
      build_file.remove_from_project if path&.end_with?('Pods-ElevenLabsTests/ExpoModulesProvider.swift')
    end

    test_target.shell_script_build_phases
      .select { |phase| phase.name == '[Expo] Configure project' }
      .each(&:remove_from_project)

    test_target.build_configurations.each do |configuration|
      configuration.build_settings['OTHER_LDFLAGS'] = ''
    end
  end

  project.save
end
