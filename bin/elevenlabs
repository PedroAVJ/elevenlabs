#!/bin/sh
set -eu

script="$0"
while [ -L "$script" ]; do
  dir="$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)"
  link="$(readlink "$script")"
  case "$link" in
    /*) script="$link" ;;
    *) script="$dir/$link" ;;
  esac
done

plugin_root="$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: elevenlabs <command> [options]

Commands:
  auth        Inspect or import the API credential using macOS Keychain
  transcribe  Transcribe audio or video with ElevenLabs Scribe

Run "elevenlabs <command> --help" for command options.
USAGE
}

command="${1:-}"
case "$command" in
  auth)
    shift
    exec python3 "$plugin_root/scripts/elevenlabs_auth.py" "$@"
    ;;
  transcribe)
    shift
    exec python3 "$plugin_root/scripts/transcribe_elevenlabs.py" "$@"
    ;;
  help | -h | --help | "")
    usage
    ;;
  *)
    printf 'elevenlabs: unknown command "%s"\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
